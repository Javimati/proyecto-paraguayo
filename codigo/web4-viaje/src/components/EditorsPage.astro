---
/** Página para editores: sin efectos, sin JS salvo copiar email y pies. Debe leerse en 30 s. */
import Base from '../layouts/Base.astro';
import ContactActions from './ContactActions.astro';
import Facts from './Facts.astro';
import { PERSON, ROUTES, T, otherLang, type Lang } from '../i18n/strings';
import { getChapterViews } from '../lib/viaje-data';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = T[lang];
const es = lang === 'es';
const views = await getChapterViews(lang);
const featured = views.flatMap((c) => c.photos).filter((p) => p.featured);
// la primera, horizontal: es la foto LCP y una vertical pesa el doble al mismo ancho
const firstH = featured.findIndex((p) => p.w > p.h);
const picks = firstH > 0 ? [featured[firstH], ...featured.filter((_, i) => i !== firstH)] : featured;
const provisional = views.some((c) => c.provisional);
const site = Astro.site!;
const jsonld = picks.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  contentUrl: new URL(p.original, site).href,
  width: p.w,
  height: p.h,
  caption: p.caption,
  creator: { '@type': 'Person', name: PERSON.name },
  creditText: PERSON.credit,
  copyrightNotice: `© ${PERSON.name}`,
}));
---

<Base
  title={t.nav.editors}
  description={es
    ? 'Selección de fotografías de Álvaro Rodríguez Valverde para editores gráficos: fotos con pie, disponibilidad para prácticas y contacto.'
    : 'A selection of photographs by Álvaro Rodríguez Valverde for photo editors: captioned pictures, internship availability and contact.'}
  lang={lang}
  altHref={ROUTES.editors[otherLang(lang)]}
  page="editors"
  jsonld={jsonld}
>
  {picks[0] && <link slot="head" rel="preload" as="image" imagesrcset={picks[0].srcset} imagesizes="(min-width: 1100px) 30vw, (min-width: 640px) 46vw, 92vw" fetchpriority="high" />}
  <main id="main" tabindex="-1" class="ed wrap">
    <header class="ed__head">
      <div class="ed__who">
        <h1 class="ed__name">{PERSON.name}</h1>
        <p class="ed__what">
          {es
            ? 'Fotógrafo de reportaje y eventos en Madrid. Busco prácticas en agencia o medio desde el 16 de febrero de 2027.'
            : 'Reportage and events photographer in Madrid. Looking for an internship at an agency or newsroom from 16 February 2027.'}
        </p>
        <ContactActions lang={lang} />
      </div>
      <div class="ed__facts">
        <Facts lang={lang} />
      </div>
    </header>

    <section aria-labelledby="ed-sel">
      <h2 class="ed__count mono" id="ed-sel">
        {es ? `${picks.length} fotos seleccionadas` : `${picks.length} selected photos`}
      </h2>
      {provisional && <p class="ed__prov mono">{t.provisional}</p>}
      <ol role="list" class="ed__grid">
        {
          picks.map((p, i) => (
            <li>
              <figure>
                <div class="ed__frame">
                  <img
                    src={p.srcMid}
                    srcset={p.srcset}
                    sizes="(min-width: 1100px) 30vw, (min-width: 640px) 46vw, 92vw"
                    width={p.w}
                    height={p.h}
                    alt={p.alt}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : undefined}
                    decoding="async"
                  />
                </div>
                <figcaption class="mono">{p.caption}</figcaption>
              </figure>
              <a class="ed__orig mono" href={p.original} target="_blank" rel="noopener">
                {es ? 'Original' : 'Original'} · {p.w}×{p.h}
              </a>
              <button
                type="button"
                class="ed__copy mono"
                data-copy={p.caption}
                data-ok={es ? 'Pie copiado' : 'Caption copied'}
                data-fail={t.copyFail}
              >
                {es ? 'Copiar pie' : 'Copy caption'}
              </button>
              <span class="ed__status mono" role="status" aria-live="polite" />
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</Base>

<style>
  .ed {
    padding-block: calc(var(--header-h) + 28px) 72px;
  }
  .ed__head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 24px clamp(24px, 5vw, 72px);
    align-items: start;
    margin-bottom: 40px;
  }
  .ed__name {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 760;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .ed__what {
    margin-block: 14px 22px;
    max-width: 52ch;
    font-size: var(--t-17);
  }
  .ed__count {
    font-weight: 500;
    margin-bottom: 6px;
  }
  .ed__prov {
    color: var(--tenue);
    margin-bottom: 20px;
  }
  /* después de la primera, cada foto se pinta (y se descarga) al acercarse: la primera (LCP) va sola */
  .ed__grid > li:nth-child(n + 2) {
    content-visibility: auto;
    contain-intrinsic-size: auto 520px;
  }
  .ed__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px var(--gap);
    align-items: start;
  }
  .ed__frame {
    background: var(--pantalla);
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
  }
  .ed__frame img {
    max-height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
  .ed__orig {
    display: inline-block;
    margin: 6px 12px 0 0;
    font-size: 0.8125rem;
    color: var(--tenue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ed__orig:hover,
  .ed__orig:focus-visible {
    color: var(--peaking);
  }
  figcaption {
    margin-top: 10px;
    color: var(--tenue);
    line-height: 1.6;
  }
  .ed__copy {
    margin-top: 8px;
    min-height: 32px;
    padding: 4px 10px;
    border: 1px solid var(--linea);
    background: none;
    cursor: pointer;
  }
  .ed__copy:hover {
    border-color: var(--peaking);
    color: var(--peaking);
  }
  .ed__status {
    margin-left: 10px;
    color: var(--peaking);
  }
  @media (max-width: 1099px) {
    .ed__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 860px) {
    .ed__head {
      grid-template-columns: 1fr;
    }
    .ed__facts {
      order: 2;
    }
  }
  @media (max-width: 639px) {
    .ed__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
<script is:inline>
  (function () {
    document.querySelectorAll('.ed__copy').forEach(function (b) {
      b.addEventListener('click', function () {
        var s = b.nextElementSibling;
        var done = function (m) { if (s) s.textContent = m; };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(b.dataset.copy).then(function () { done(b.dataset.ok); }, function () { done(b.dataset.fail); });
        } else done(b.dataset.fail);
      });
    });
  })();
</script>
