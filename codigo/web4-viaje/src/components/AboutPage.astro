---
import Base from '../layouts/Base.astro';
import Facts from './Facts.astro';
import ContactActions from './ContactActions.astro';
import { ROUTES, T, otherLang, type Lang } from '../i18n/strings';
import { foto } from '../lib/fotos';
import retratoImg from '../assets/retrato/01.jpg';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = T[lang];
const es = lang === 'es';
// Retrato real (el mismo de la web 2), a calidad nativa como el resto de fotos (scripts/build-photos.mjs)
const retrato = foto('retrato', retratoImg);
const retratoAlt = es ? 'Retrato de Álvaro Rodríguez Valverde' : 'Portrait of Álvaro Rodríguez Valverde';
---
<Base
  title={t.nav.about}
  description={es
    ? 'Sobre Álvaro Rodríguez Valverde: fotografía de calle, fotorreportaje y eventos. Estudiante en Campus FP Atocha, Arganda del Rey (Madrid).'
    : 'About Álvaro Rodríguez Valverde: street photography, reportage and events. Student at Campus FP Atocha, Arganda del Rey (Madrid).'}
  lang={lang}
  altHref={ROUTES.about[otherLang(lang)]}
  page="about"
  ogImage={retratoImg}
  ogAlt={retratoAlt}
>
  <link slot="head" rel="preload" as="image" imagesrcset={retrato.srcset} imagesizes="(min-width: 900px) 30vw, 92vw" fetchpriority="high" />
  <main id="main" tabindex="-1" class="about wrap">
    <div class="about__photo">
      <div class="about__frame">
        <img src={retrato.src} srcset={retrato.srcset} sizes="(min-width: 900px) 30vw, 92vw" width={retrato.width} height={retrato.height} alt={retratoAlt} decoding="async" fetchpriority="high" />
        <span class="frame-marks" aria-hidden="true"></span>
      </div>
      <p class="mono meta">Álvaro Rodríguez Valverde</p>
    </div>
    <div class="about__body">
      <p class="mono meta">{t.nav.about}</p>
      <h1 class="about__title">{es ? 'Hago fotos de lo que pasa delante de mí.' : 'I photograph what happens in front of me.'}</h1>
      <div class="about__bio">
        {es ? (
          <>
            <p class="about__hello">
              Soy Álvaro Rodríguez, tengo 20 años y vivo en Arganda del Rey (Madrid). Estudio 2.º del Grado Superior de Técnico en
              Iluminación, Captación y Tratamiento de la Imagen en Campus FP Atocha.
            </p>
            <p>Lo que más me gusta es la fotografía de calle: salir con la cámara y estar atento a lo que pasa delante de mí. Quiero dedicarme al fotorreportaje y a la actualidad.</p>
            <p>Me quedo con lo que pasa en un segundo y no se repite: un gesto, una luz que dura un instante, los detalles que casi nadie ve.</p>
            <p>También me gustan mucho los conciertos y los eventos: la energía de un directo, la gente en la pista. Gracias a lo que estudio me muevo bien con cualquier luz, desde una sala a oscuras hasta un exterior, y edito en Lightroom Classic y Photoshop para entregar fotos cuidadas.</p>
            <p>
              Estoy construyendo mi trayectoria y busco prácticas en una agencia o un medio desde el 16 de febrero de 2027. Si crees que
              puedo encajar, <a href={ROUTES.contact[lang]}>escríbeme</a>.
            </p>
          </>
        ) : (
          <>
            <p class="about__hello">
              I’m Álvaro Rodríguez, I’m 20 and I live in Arganda del Rey (Madrid). I’m in my second year of the Higher Vocational
              Diploma in Lighting, Image Capture and Processing at Campus FP Atocha.
            </p>
            <p>What I love most is street photography: going out with the camera and paying attention to what happens in front of me. I want to work in reportage and news.</p>
            <p>I go after what happens in a second and never repeats: a gesture, a light that lasts an instant, the details almost nobody notices.</p>
            <p>I also really enjoy gigs and events: the energy of a live show, people on the dance floor. What I study means I’m comfortable in any light, from a pitch-dark venue to outdoors, and I edit in Lightroom Classic and Photoshop to deliver carefully finished pictures.</p>
            <p>
              I’m building my path and looking for an internship at an agency or newsroom from 16 February 2027. If you think I could
              fit in, <a href={ROUTES.contact[lang]}>get in touch</a>.
            </p>
          </>
        )}
      </div>
      <section class="about__ref" aria-labelledby="what-t">
        <h2 id="what-t" class="mono">{es ? 'Qué fotografío' : 'What I shoot'}</h2>
        <p>
          {es
            ? 'Fotografía de calle, fotorreportaje y actualidad. También conciertos en sala y teatro, festivales, fiestas, club, eventos y bodas.'
            : 'Street photography, reportage and news. Also club and theatre gigs, festivals, parties, club nights, events and weddings.'}
        </p>
      </section>
      <Facts lang={lang} />
      <section class="about__ref" aria-labelledby="contact-t">
        <h2 id="contact-t" class="mono">{t.nav.contact}</h2>
        <ContactActions lang={lang} />
      </section>
      <p class="about__cta"><a class="btn btn--solid" href={ROUTES.contact[lang]}>{t.nav.contact}</a></p>
    </div>
  </main>
</Base>
<style>
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px var(--gap);
    padding-block: calc(var(--header-h) + 40px) 96px;
    align-items: start;
  }
  .about__photo {
    grid-column: 1 / 5;
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 12px;
  }
  .about__frame {
    position: relative;
    color: var(--tenue);
  }
  .about__frame .frame-marks {
    inset: -10px;
  }
  .about__body {
    grid-column: 6 / -1;
    display: grid;
    gap: 28px;
    max-width: 70ch;
  }
  .about__title {
    font-size: clamp(2.2rem, 5vw, 4.6rem);
    font-weight: 760;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .about__bio {
    display: grid;
    gap: 1em;
    font-size: var(--t-21);
    line-height: 1.5;
  }
  .about__bio a {
    text-decoration: underline;
    text-decoration-color: var(--peaking);
    text-underline-offset: 4px;
  }
  .about__frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .about__ref h2 {
    font-weight: 500;
    color: var(--peaking);
    margin-bottom: 6px;
  }
  .about__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 899px) {
    .about__photo,
    .about__body {
      grid-column: 1 / -1;
      position: static;
    }
    .about__photo {
      max-width: 420px;
    }
  }
</style>
