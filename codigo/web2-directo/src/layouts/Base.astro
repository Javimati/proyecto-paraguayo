---
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import archivoUrl from '../styles/fonts/archivo-text.woff2?url';
import markerUrl from '../styles/fonts/permanent-marker-caps.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import AppScripts from '../components/AppScripts.astro';
import { PERSON, T, type Lang } from '../i18n/strings';
import retrato from '../assets/retrato-alvaro.jpg';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  altHref: string;
  theme?: 'escenario' | 'papel';
  ogImage?: ImageMetadata;
  ogAlt?: string;
  jsonld?: Record<string, unknown>[];
  enhanced?: boolean;
  page?: 'home' | 'event' | 'promoters' | 'about' | 'notfound';
  ambient?: boolean;
  headerless?: boolean;
  /** precarga la Permanent Marker (solo la home la usa en el primer pantallazo) */
  preloadMarker?: boolean;
  /** 404: sin canonical ni hreflang, noindex */
  noindex?: boolean;
  /** precarga de la foto LCP (srcset + sizes) para que se pida desde el primer byte */
  preloadImage?: { srcset: string; sizes: string };
}
const {
  title, description, lang, altHref, theme = 'escenario', ogImage, ogAlt, jsonld = [], preloadImage,
  enhanced = true, page = 'home', ambient = false, headerless = false, preloadMarker = false, noindex = false,
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const altUrl = new URL(altHref, site).href;
const esUrl = lang === 'es' ? canonical : altUrl;
const enUrl = lang === 'en' ? canonical : altUrl;

let og: string | undefined;
if (ogImage) {
  const img = await getImage({ src: ogImage, width: 1200, format: 'jpg', quality: 78 });
  og = new URL(img.src, site).href;
}
const retratoImg = await getImage({ src: retrato, width: 800, format: 'jpg', quality: 80 });
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PERSON.name,
  jobTitle: lang === 'es' ? 'Fotógrafo de conciertos y eventos' : 'Concert and event photographer',
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  url: new URL('/', site).href,
  ...(PERSON.email ? { email: `mailto:${PERSON.email}` } : {}),
  ...(PERSON.phoneIntl ? { telephone: PERSON.phoneIntl } : {}),
  image: new URL(retratoImg.src, site).href,
};
const fullTitle = page === 'home' || page === 'notfound' ? title : `${title} — ${PERSON.shortName}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preloadImage && <link rel="preload" as="image" imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="es" href={esUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={esUrl} />}
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    {preloadMarker && <link rel="preload" href={markerUrl} as="font" type="font/woff2" crossorigin />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content={theme === 'papel' ? '#f4f4f1' : '#1b1a1d'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${PERSON.name} — ${lang === 'es' ? 'Directo' : 'Live'}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    {og && <meta property="og:image" content={og} />}
    {og && ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    <script type="application/ld+json" set:html={JSON.stringify([person, ...jsonld])} />
    {
      enhanced && (
        <script is:inline data-astro-rerun>
          (function (d) {
            var m = window.matchMedia;
            if (m('(prefers-reduced-motion: reduce)').matches) return;
            d.classList.add('motion');
            if (m('(min-width: 1024px) and (pointer: fine)').matches) d.classList.add('wide');
          })(document.documentElement);
        </script>
      )
    }
    {enhanced && <ClientRouter fallback="swap" />}
  </head>
  <body class={`theme-${theme}`} data-page={page} data-ambient={ambient ? '' : undefined}>
    <a class="skip-link" href="#main">{T[lang].skip}</a>
    {!headerless && <SiteHeader lang={lang} altHref={altHref} page={page} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {enhanced && <AppScripts />}
  </body>
</html>
