---
// "Para promotores": sin efectos, sin router. Debe cargar en < 1 s y leerse en 30.
import { Picture, Image, getImage } from 'astro:assets';
import retrato from '../assets/retrato-alvaro.jpg';
import Base from '../layouts/Base.astro';
import { PERSON, ROUTES, T, chronicleCaption, type Lang } from '../i18n/strings';
import { getEvents, cleanTitle } from '../lib/events';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = T[lang];
const es = lang === 'es';
const events = await getEvents();
const picks = events.flatMap((e) =>
  e.data.photos
    .filter((p) => p.selected)
    .map((p) => ({ p, e, title: cleanTitle(es ? e.data.title : e.data.title_en).text })),
);
const anyProvisional = events.some((e) => e.data.provisional);
const site = Astro.site!;
const jsonld = await Promise.all(
  picks.map(async ({ p, e }) => {
    const img = await getImage({ src: p.file, width: 1600, format: 'jpg' });
    const date = p.date ?? e.data.date;
    return {
      '@context': 'https://schema.org',
      '@type': 'ImageObject',
      contentUrl: new URL(img.src, site).href,
      caption: chronicleCaption(p.venue ?? e.data.venue, p.city ?? e.data.city, date, es ? p.caption : p.caption_en, lang),
      description: es ? p.alt : p.alt_en,
      creator: { '@type': 'Person', name: PERSON.name },
      creditText: PERSON.credit,
      copyrightNotice: date ? `© ${date.getUTCFullYear()} ${PERSON.name}` : `© ${PERSON.name}`,
    };
  }),
);
const covers = es
  ? 'Conciertos en sala y teatro, festivales, fiestas y club, y eventos. Bodas, en segundo plano.'
  : 'Club and theatre gigs, festivals, parties and club nights, and events. Weddings as a secondary line.';
const sizes = '(min-width: 1100px) calc(33vw - 54px), (min-width: 640px) calc(50vw - 48px), calc(100vw - 32px)';
---

<Base
  title={t.nav.promoters}
  description={es
    ? 'Fotografía de directo de Álvaro Rodríguez Valverde para promotores, salas y bandas: selección con pies, qué cubre y contacto.'
    : 'Live photography by Álvaro Rodríguez Valverde for promoters, venues and bands: selects with captions, coverage and contact.'}
  lang={lang}
  altHref={ROUTES.promoters[es ? 'en' : 'es']}
  theme="papel"
  page="promoters"
  enhanced={false}
  ogImage={picks[0]?.p.file}
  ogAlt={picks[0] ? (es ? picks[0].p.alt : picks[0].p.alt_en) : undefined}
  jsonld={jsonld}
>
  <div class="pr wrap">
    <section class="pr__head" aria-labelledby="pr-name">
      <div class="pr__id">
        <Image
          src={retrato}
          alt={es ? 'Retrato de Álvaro Rodríguez Valverde' : 'Portrait of Álvaro Rodríguez Valverde'}
          widths={[96, 160]}
          sizes="72px"
          quality={78}
          loading="eager"
          decoding="async"
          class="pr__face"
        />
        <h1 id="pr-name">{PERSON.name}</h1>
      </div>
      <p class="pr__what">
        {es ? 'Fotografía de directo para salas, festivales y bandas. Madrid.' : 'Live photography for venues, festivals and bands. Madrid.'}
      </p>
      <dl class="pr__facts">
        <div>
          <dt>{es ? 'Cubro' : 'I cover'}</dt>
          <dd>{covers}</dd>
        </div>
        <div>
          <dt>{es ? 'Disponibilidad' : 'Availability'}</dt>
          <dd>
            {es
              ? 'Madrid y toda la Comunidad de Madrid: me muevo en transporte público. '
              : 'Madrid and the whole Madrid region: I travel by public transport. '}
            {/* TODO(disponibilidad): fechas concretas para encargos */}
            <span class="todo">TODO: {es ? 'fechas' : 'dates'}</span>
          </dd>
        </div>
        <div>
          <dt>{es ? 'Tarifas' : 'Rates'}</dt>
          <dd>{/* TODO(tarifas): no inventar precios */}<span class="todo">TODO: {es ? 'tarifas o «a consultar»' : 'rates or “on request”'}</span></dd>
        </div>
        <div>
          <dt>{es ? 'Entrega' : 'Delivery'}</dt>
          <dd>{/* TODO(entrega) */}<span class="todo">TODO: {es ? 'plazo y formato' : 'turnaround and format'}</span></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${PERSON.email}`}>{PERSON.email}</a></dd>
        </div>
        <div>
          <dt>{es ? 'Teléfono' : 'Phone'}</dt>
          <dd><a href={`tel:${PERSON.phoneIntl}`}>{PERSON.phone}</a></dd>
        </div>
        <div>
          <dt>{es ? 'Edición' : 'Editing'}</dt>
          <dd>{es ? 'Lightroom Classic y Photoshop. Inglés B1.' : 'Lightroom Classic and Photoshop. English B1.'}</dd>
        </div>
        <div>
          <dt>{es ? 'Formación' : 'Training'}</dt>
          <dd>
            {es
              ? '2.º del Grado Superior de Iluminación, Captación y Tratamiento de Imagen (Campus FP Atocha).'
              : 'Second year, Higher Vocational Diploma in Lighting, Image Capture and Processing (Campus FP Atocha).'}
          </dd>
        </div>
      </dl>
      <div class="pr__actions">
        {PERSON.portfolioPdf && <a class="btn btn--primary" href={PERSON.portfolioPdf} download>{t.downloadPdf}</a>}
        {/* Sin email no hay botón: el hueco se ve como TODO en la ficha */}
        {PERSON.email && <button class="btn" type="button" data-copy-email={PERSON.email} data-copied={t.copied}>{t.copyEmail}</button>}
        {PERSON.email && <span id="copy-status" class="pr__status" role="status"></span>}
      </div>
      {anyProvisional && <p class="pr__provisional">{t.provisional}</p>}
    </section>

    <section aria-labelledby="pr-picks">
      <h2 id="pr-picks" class="pr__h2">{es ? `${picks.length} fotos seleccionadas` : `${picks.length} selected photos`}</h2>
      <ol class="pr__grid" role="list">
        {
          picks.map(({ p, e, title }, i) => (
            <li>
              <figure>
                <Picture
                  src={p.file}
                  alt={es ? p.alt : p.alt_en}
                  formats={['avif', 'webp']}
                  widths={[480, 720, 1000]}
                  sizes={sizes}
                  quality={i === 0 ? 62 : 72}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
                <figcaption>
                  {chronicleCaption(p.venue ?? e.data.venue, p.city ?? e.data.city, p.date ?? e.data.date, es ? p.caption : p.caption_en, lang)}
                  <a class="pr__ev" href={ROUTES.event[lang](e.id)}>{title}</a>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <script is:inline>
    (function () {
      var b = document.querySelector('[data-copy-email]');
      if (!b) return;
      b.addEventListener('click', function () {
        var e = b.getAttribute('data-copy-email'), s = document.getElementById('copy-status');
        var ok = function () { s.textContent = b.getAttribute('data-copied') + ': ' + e; };
        var fail = function () { s.textContent = e; };
        try { navigator.clipboard.writeText(e).then(ok, fail); } catch (_) { fail(); }
      });
    })();
  </script>
</Base>

<style>
  .pr { padding-bottom: 96px; }
  .pr__head { padding-block: 16px 32px; }
  @media (min-width: 1024px) {
    .pr__head {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-template-areas: 'name name' 'what facts' 'actions facts' 'prov facts';
      column-gap: clamp(32px, 5vw, 80px);
      align-items: start;
    }
    .pr__id { grid-area: name; }
    .pr__what { grid-area: what; }
    .pr__facts { grid-area: facts; margin-top: 18px !important; }
    .pr__actions { grid-area: actions; }
    .pr__provisional { grid-area: prov; }
  }
  h1 {
    font-size: clamp(1.6rem, 3vw, 2.75rem);
    font-weight: 650;
    font-stretch: 100%;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  @media (min-width: 1024px) { h1 { white-space: nowrap; } }
  .pr__id { display: flex; align-items: center; gap: 16px; }
  .pr__face { width: 72px; height: 72px; object-fit: cover; border: 4px solid var(--papel, #f4f4f1); transform: rotate(-2deg); flex: none; }
  .pr__what { margin-top: 14px; max-width: 58ch; }
  .pr__facts { margin-top: 22px; display: grid; gap: 10px; font-size: var(--t-14); }
  .pr__facts div { display: grid; grid-template-columns: minmax(0, 8.5rem) minmax(0, 1fr); gap: 12px; }
  @media (max-width: 639px) { .pr__facts div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
  .pr__facts dt { color: var(--muted); font-family: var(--f-cond); font-stretch: 72%; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; }
  .pr__actions { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .btn {
    display: inline-block; min-height: 44px; padding: 12px 18px;
    border: 2px solid var(--rotulador); background: transparent;
    font-size: var(--t-14); font-weight: 650; text-decoration: none; cursor: pointer;
  }
  .btn--primary { background: var(--rotulador); color: var(--papel); }
  .btn--primary:hover { background: #8a4a00; border-color: #8a4a00; color: var(--papel); }
  .btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .pr__status { font-size: var(--t-14); color: var(--muted); }
  .pr__provisional { margin-top: 14px; font-size: var(--t-12); color: #8a4a00; }
  .pr__h2 {
    font-size: var(--t-14); font-weight: 650; font-family: var(--f-cond); font-stretch: 72%; text-transform: uppercase; letter-spacing: 0.03em;
    padding-block: 12px; border-top: 2px solid var(--rotulador); margin-bottom: 24px;
  }
  .pr__grid { display: grid; gap: 44px 24px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .pr__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .pr__grid { grid-template-columns: repeat(3, 1fr); } }
  figure img { width: 100%; aspect-ratio: 3 / 2; object-fit: contain; background: var(--escenario); }
  figcaption { margin-top: 10px; font-size: var(--t-12); line-height: 1.6; max-width: 60ch; }
  .pr__ev { display: block; margin-top: 6px; color: var(--muted); }
</style>
