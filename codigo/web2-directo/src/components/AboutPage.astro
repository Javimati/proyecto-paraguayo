---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import retrato from '../assets/retrato-alvaro.jpg';
import { PERSON, ROUTES, T, type Lang } from '../i18n/strings';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = T[lang];
const es = lang === 'es';
---
<Base
  title={t.nav.about}
  description={es
    ? 'Sobre Álvaro Rodríguez Valverde: fotografía de directo, formación y contacto.'
    : 'About Álvaro Rodríguez Valverde: live photography, training and contact.'}
  lang={lang}
  altHref={ROUTES.about[es ? 'en' : 'es']}
  theme="escenario"
  page="about"
  ogImage={retrato}
  ogAlt={es ? 'Retrato de Álvaro Rodríguez Valverde' : 'Portrait of Álvaro Rodríguez Valverde'}
>
  <div class="ab wrap">
    <section class="ab__intro" aria-labelledby="ab-title">
      <figure class="ab__portrait">
        <div class="polaroid">
          <span class="polaroid__tape" aria-hidden="true"></span>
          <Image
            src={retrato}
            alt={es ? 'Retrato de Álvaro Rodríguez Valverde' : 'Portrait of Álvaro Rodríguez Valverde'}
            widths={[320, 480, 640, 800]}
            sizes="(min-width: 768px) 16vw, 42vw"
            quality={80}
            loading="eager"
            decoding="async"
            class="polaroid__img"
          />
        </div>
      </figure>
      <div class="ab__lead">
        <h1 id="ab-title" class="ab__title">{es ? 'Sobre mí' : 'About'}</h1>
        <div class="ab__bio">
          {es ? (
            <>
              <p class="ab__hello">Soy Álvaro Rodríguez, tengo 20 años y vivo en Madrid.</p>
              <p>Me encanta la fotografía, y donde más la disfruto es en un evento: con la música a tope, la gente a lo suyo y la cámara en la mano.</p>
              <p>Me quedo con lo que pasa en un segundo y se recuerda para siempre: la energía de un directo, un abrazo en mitad de la pista, los detalles que casi nadie ve.</p>
              <p>Estudio el Grado Superior de Técnico en Iluminación, Captación y Tratamiento de la Imagen. Gracias a eso me muevo bien con cualquier luz, desde una sala a oscuras hasta un exterior, y entrego fotos cuidadas, con acabado profesional.</p>
              <p>Estoy empezando y tengo muchas ganas. Busco colaborar en conciertos, fiestas y eventos. Si quieres que tu evento quede bien contado, <a href={`mailto:${PERSON.email}`}>escríbeme</a>.</p>
            </>
          ) : (
            <>
              <p class="ab__hello">I’m Álvaro Rodríguez, I’m 20 and I live in Madrid.</p>
              <p>I love photography, and where I enjoy it most is at an event: music up loud, people lost in the moment and a camera in my hand.</p>
              <p>I go after what happens in a second and stays with you forever: the energy of a live show, a hug in the middle of the dance floor, the details almost nobody notices.</p>
              <p>I’m studying a Higher Vocational Diploma in Lighting, Image Capture and Processing. That means I’m comfortable in any light, from a pitch-dark venue to outdoors, and I deliver carefully finished, professional images.</p>
              <p>I’m just starting out and I’m hungry for it. I’m looking to work on gigs, parties and events. If you want your event told well, <a href={`mailto:${PERSON.email}`}>get in touch</a>.</p>
            </>
          )}
        </div>
      </div>
    </section>

    <div class="ab__info">
    <section class="ab__block" aria-labelledby="ab-what">
      <h2 id="ab-what" class="ab__h2 ficha">{es ? 'Qué fotografío' : 'What I shoot'}</h2>
      <p>
        {es
          ? 'Conciertos en sala y teatro, festivales, fiestas, club y eventos. También me interesan las bodas, el fotoperiodismo, la fotografía de calle y el reportaje.'
          : 'Club and theatre gigs, festivals, parties, club nights and events. I’m also interested in weddings, photojournalism, street photography and reportage.'}
      </p>
    </section>

    <section class="ab__block" aria-labelledby="ab-edu">
      <h2 id="ab-edu" class="ab__h2 ficha">{es ? 'Formación' : 'Training'}</h2>
      <p>
        {es
          ? '2.º del Grado Superior de Técnico en Iluminación, Captación y Tratamiento de la Imagen. Campus FP Atocha, Madrid.'
          : 'Second year, Higher Vocational Diploma in Lighting, Image Capture and Processing. Campus FP Atocha, Madrid.'}
      </p>
      <p>
        {es
          ? 'Grado Medio de Técnico en Vídeo Disc-jockey y Sonido. Campus FP Arganda.'
          : 'Intermediate Vocational Diploma in Video DJ and Sound. Campus FP Arganda.'}
      </p>
    </section>

    <section class="ab__block" aria-labelledby="ab-contact">
      <h2 id="ab-contact" class="ab__h2 ficha">{es ? 'Contacto' : 'Contact'}</h2>
      <dl class="ab__contact">
        <div>
          <dt>Email</dt>
          <dd>
                <a href={`mailto:${PERSON.email}`}>{PERSON.email}</a>
                <button type="button" class="ab__copy" data-copy-email={PERSON.email} data-copied={t.copied}>{t.copyEmail}</button>
          </dd>
        </div>
        <div>
          <dt>{es ? 'Teléfono' : 'Phone'}</dt>
          <dd><a href={`tel:${PERSON.phoneIntl}`}>{PERSON.phone}</a></dd>
        </div>
        {PERSON.cvPdf && (
          <div>
            <dt>CV</dt>
            <dd><a href={PERSON.cvPdf} download>{t.downloadCv}</a></dd>
          </div>
        )}
      </dl>
      <p class="ab__status" role="status" aria-live="polite" data-copy-status></p>
    </section>

    </div>
  </div>
</Base>
<style>
  .ab {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    padding-block: clamp(8px, 2vw, 24px) clamp(64px, 10vw, 140px);
  }
  .ab__intro {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: start;
    padding-block: clamp(16px, 3vw, 40px) clamp(28px, 4vw, 48px);
  }
  .ab__portrait { grid-column: 1 / 3; }
  /* Retrato pegado con cinta, como una polaroid sobre el setlist. Sin filtros: color intacto. */
  .polaroid {
    position: relative;
    background: var(--papel, #f4f4f1);
    padding: 8px 8px 28px;
    transform: rotate(-1.6deg);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
    max-width: 360px;
  }
  .polaroid__img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; }
  .polaroid__tape {
    position: absolute;
    top: -12px;
    left: 50%;
    width: 84px;
    height: 24px;
    transform: translateX(-50%) rotate(3deg);
    background: rgba(143, 141, 136, 0.82);
    z-index: 1;
  }
  .ab__lead { grid-column: 4 / 12; }
  .ab__title {
    font-family: var(--f-cond);
    font-size: var(--t-14);
    font-weight: 600;
    font-stretch: 72%;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ab__bio { margin-top: 14px; font-size: var(--t-25); line-height: 1.45; max-width: 40ch; display: grid; gap: 0.8em; }
  .ab__hello { font-family: var(--f-marker); font-size: var(--t-39); line-height: 1.1; text-transform: none; }
  .ab__bio a { color: inherit; text-decoration: underline; text-decoration-color: var(--luz-trabajo); text-underline-offset: 0.18em; }
  .ab__block {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    padding-block: 20px;
    border-top: 1px solid rgba(236, 235, 231, 0.18);
  }
  .ab__h2 { grid-column: 1 / 4; font-size: var(--t-14); font-weight: 600; color: var(--muted); text-transform: uppercase; }
  .ab__block > :not(h2) { grid-column: 4 / 11; max-width: 62ch; font-size: var(--t-20); line-height: 1.5; }
  .ab__contact { display: grid; gap: 8px; }
  .ab__contact div { display: grid; grid-template-columns: 8rem 1fr; gap: 12px; align-items: baseline; }
  .ab__contact dt { color: var(--muted); }
  .ab__copy { margin-left: 12px; background: none; border: 1px solid currentColor; padding: 4px 10px; cursor: pointer; min-height: 32px; }
  .ab__status { grid-column: 4 / 11; margin-top: 8px; color: var(--muted); font-size: var(--t-14); }
  .ab__info { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; }
  /* Escritorio ancho: la ficha (qué fotografío, formación, contacto) a la derecha de la bio */
  @media (min-width: 1100px) {
    .ab__intro { grid-column: 1 / 9; grid-row: 1; }
    .ab__portrait { grid-column: 1 / 4; }
    .ab__lead { grid-column: 4 / 9; }
    .ab__info {
      grid-column: 9 / 13;
      grid-row: 1;
      display: block;
      align-self: start;
      padding-top: clamp(16px, 3vw, 40px);
    }
    .ab__info .ab__block { display: block; padding-block: 16px; }
    .ab__info .ab__block:first-child { border-top: 0; padding-top: 0; }
    .ab__info .ab__h2 { margin-bottom: 8px; }
    .ab__info .ab__block > :not(h2) { max-width: none; font-size: var(--t-16, 1rem); }
    .ab__info .ab__contact div { grid-template-columns: 5.5rem 1fr; }
    .ab__info .ab__copy { margin: 6px 0 0; display: block; }
  }
  @media (max-width: 767px) {
    .ab__h2, .ab__block > :not(h2), .ab__status, .ab__lead { grid-column: 1 / -1; }
    .ab__portrait { grid-column: 1 / 10; margin-bottom: 24px; }
    .ab__h2 { margin-bottom: 8px; }
  }
</style>
