---
import { Picture, Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Caption from './Caption.astro';
import { PERSON, ROUTES, T, numDate, chronicleCaption, creditCaption, type Lang } from '../i18n/strings';
import { fichaParts } from '../i18n/strings';
import { getEvents, photoId, anchor, isPortrait, cleanTitle, gelFor, fileName, showName, type Event } from '../lib/events';

interface Props { lang: Lang; entry: Event; }
const { lang, entry } = Astro.props;
const t = T[lang];
const es = lang === 'es';
const all = await getEvents();
const idx = all.findIndex((e) => e.id === entry.id);
const next = all[(idx + 1) % all.length];
const d = entry.data;
const title = cleanTitle(es ? d.title : d.title_en);
const summary = es ? d.summary : d.summary_en;
const other: Lang = es ? 'en' : 'es';
const total = String(d.photos.length).padStart(2, '0');
const nextName = showName(next, lang);
const name = showName(entry, lang);

const site = Astro.site!;
const imageObjects = await Promise.all(
  d.photos.map(async (p) => {
    const img = await getImage({ src: p.file, width: 1600, format: 'jpg' });
    const date = p.date ?? d.date;
    const place = [p.venue ?? d.venue, p.city ?? d.city].filter(Boolean).join(', ');
    return {
      '@context': 'https://schema.org',
      '@type': 'ImageObject',
      contentUrl: new URL(img.src, site).href,
      caption: chronicleCaption(p.venue ?? d.venue, p.city ?? d.city, date, es ? p.caption : p.caption_en, lang),
      description: es ? p.alt : p.alt_en,
      creator: { '@type': 'Person', name: PERSON.name },
      creditText: PERSON.credit,
      copyrightNotice: date ? `© ${date.getUTCFullYear()} ${PERSON.name}` : `© ${PERSON.name}`,
      ...(date ? { dateCreated: date.toISOString().slice(0, 10) } : {}),
      ...(place ? { contentLocation: { '@type': 'Place', name: place } } : {}),
    };
  }),
);
const ci = 0; // la portada es siempre la primera foto (getEvents)
const ficha = fichaParts(d, lang);
---

<Base
  title={title.text}
  description={summary}
  lang={lang}
  altHref={ROUTES.event[other](entry.id)}
  theme="escenario"
  page="event"
  ambient
  preloadMarker
  ogImage={d.cover}
  ogAlt={es ? d.photos[ci].alt : d.photos[ci].alt_en}
  jsonld={imageObjects}
>
  <article class="ev" data-event data-slug={entry.id} data-home={ROUTES.home[lang]}>
    <header class="ev__head wrap">
      <p class="ev__back"><a href={ROUTES.home[lang]}>{t.backToSetlist}</a></p>
      <div class="stub">
        <span class="stub__tape" aria-hidden="true"></span>
        <p class="stub__kicker ficha">{t.track} {String(idx + 1).padStart(2, '0')} / {String(all.length).padStart(2, '0')}</p>
        <h1 class="stub__name" tabindex="-1" data-event-title>{name}</h1>
        <p class="stub__ficha ficha">
          {d.mixed ? (
            <span>{ficha.place}</span>
          ) : (
            <>
              {d.venue ? <span>{d.venue}</span> : <span>{t.placePending}</span>}
              {d.city && <span>{d.city}</span>}
              <span>{d.date ? numDate(d.date) : t.datePending}</span>
            </>
          )}
          {d.time && <span>{d.time}</span>}
          <span>{t.photos(d.photos.length)}</span>
        </p>
      </div>
      <p class="ev__summary">{summary}</p>
      {(title.provisional || d.provisional) && <p class="ev__provisional">{t.provisional}</p>}
    </header>

    <div class="film" role="region" aria-label={t.filmLabel} tabindex="0" data-film>
      <ol class="film__list" role="list">
        {
          d.photos.map((p, i) => {
            const own = !p.venue && !p.city && !p.date;
            return (
              <li
                class:list={['shot', { 'shot--portrait': isPortrait(p) }]}
                id={anchor(i)}
                data-shot={i + 1}
                data-gel={gelFor(entry.id, fileName(p))}
              >
                <figure>
                  <div
                    class="shot__window"
                    data-reveal={i === 0 ? undefined : true}
                    data-vt-id={photoId(entry.id, i)}
                    data-gl-photo
                    style={`--ar:${p.file.width / p.file.height}`}
                  >
                    <Picture
                      src={p.file}
                      alt={es ? p.alt : p.alt_en}
                      formats={['avif', 'webp']}
                      widths={isPortrait(p) ? [480, 720, 1000] : [800, 1280, 1800]}
                      sizes={isPortrait(p) ? '(min-width: 1024px) 57vh, min(calc(100vw - 32px), 32vh)' : '(min-width: 1024px) min(66vw, 1100px), calc(100vw - 32px)'}
                      quality={74}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      fetchpriority={i === 0 ? 'high' : undefined}
                      decoding="async"
                    />
                  </div>
                  <div class="shot__side">
                    {own ? (
                      <figcaption class="caption">{creditCaption(es ? p.caption : p.caption_en, lang)}</figcaption>
                    ) : (
                      <Caption
                        venue={p.venue ?? d.venue}
                        city={p.city ?? d.city}
                        date={p.date ?? d.date}
                        text={es ? p.caption : p.caption_en}
                        lang={lang}
                      />
                    )}
                  </div>
                </figure>
              </li>
            );
          })
        }
      </ol>
    </div>

    <p class="counter" aria-hidden="true"><span class="counter__tape">{t.track} <span data-counter>01</span>/{total}</span></p>

    <nav class="next wrap" aria-label={t.next}>
      <a href={ROUTES.event[lang](next.id)} data-astro-prefetch="viewport" class="next__link">
        <span class="next__label ficha">{t.next}</span>
        <Image src={next.data.cover} alt="" widths={[400, 640, 1000]} sizes="(min-width: 1024px) 400px, calc(100vw - 32px)" loading="lazy" decoding="async" class="next__img" />
        <span class="next__title">{nextName}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .ev__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    padding-block: clamp(8px, 2vw, 24px) clamp(32px, 5vw, 64px);
  }
  .ev__back { grid-column: 1 / -1; font-size: var(--t-14); }
  .ev__back a { display: inline-block; padding-block: 12px; }

  /* Resguardo del setlist: tira de papel con cinta, el nombre a rotulador y la ficha condensada */
  .stub {
    grid-column: 1 / 9;
    position: relative;
    margin-top: clamp(12px, 2vw, 24px);
    padding: clamp(18px, 2.4vw, 28px) clamp(18px, 2.4vw, 32px) clamp(14px, 2vw, 22px);
    color: var(--rotulador);
    isolation: isolate;
    width: fit-content;
    max-width: 100%;
  }
  .stub::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--papel);
    box-shadow: 0 14px 30px -16px rgba(0, 0, 0, 0.8);
    transform: rotate(-0.8deg);
  }
  .stub__tape {
    position: absolute;
    top: -12px;
    left: clamp(20px, 6%, 64px);
    width: 110px;
    height: 28px;
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.06) 0 2px, transparent 2px 5px),
      var(--cinta);
    opacity: 0.92;
    transform: rotate(-4deg);
    clip-path: polygon(3% 0, 97% 4%, 100% 30%, 98% 60%, 100% 100%, 2% 96%, 0 70%, 2% 40%);
  }
  .stub__kicker { font-size: var(--t-14); color: var(--meta-papel); text-transform: uppercase; }
  .stub__name {
    margin-top: 4px;
    font-family: var(--f-marker);
    font-weight: 400;
    font-size: var(--t-title);
    line-height: 1;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    hyphens: auto;
    outline: none;
  }
  .stub__ficha {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    font-size: var(--t-16);
    text-transform: uppercase;
    color: var(--rotulador);
  }
  .stub__ficha > span:not(:last-child)::after {
    content: '/';
    margin-inline: 0.6em;
    color: var(--meta-papel);
  }
  .ev__summary { grid-column: 1 / 8; margin-top: 22px; max-width: 62ch; color: var(--fg); }
  .ev__provisional { grid-column: 1 / 8; margin-top: 10px; font-size: var(--t-12); color: var(--meta); }

  .film__list {
    display: grid;
    gap: clamp(56px, 10vh, 120px);
    padding-inline: var(--margin);
  }
  .film:focus-visible { outline-offset: -3px; }
  .shot { scroll-margin-top: 24px; }
  .shot figure {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: end;
  }
  .shot__window { grid-column: 1 / 10; width: 100%; }
  .shot__window :global(picture) { width: 100%; }
  .shot__window :global(img) {
    width: min(100%, calc(86vh * var(--ar)));
    height: auto;
    background: #000;
  }
  /* verticales pegadas a su pie (a la derecha de su zona) */
  .shot--portrait .shot__window :global(img) { margin-inline: auto 0; }
  .shot__side { grid-column: 10 / -1; padding-bottom: 4px; }
  .shot__side :global(.caption) { font-size: var(--t-14); line-height: 1.6; max-width: var(--measure); color: var(--fg); }

  /* Un solo contador, en marcador sobre una tira de cinta; el gel de la foto en pantalla tiñe su borde */
  .counter {
    position: fixed;
    right: var(--margin);
    bottom: 16px;
    z-index: 20;
    display: none;
    pointer-events: none;
  }
  .counter__tape {
    display: inline-block;
    padding: 4px 14px 3px;
    font-family: var(--f-marker);
    font-size: var(--t-16);
    text-transform: uppercase;
    color: var(--rotulador);
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.08) 0 2px, transparent 2px 5px),
      #b9b6b0;
    border-bottom: 3px solid var(--ambient, var(--luz-trabajo));
    transform: rotate(-2deg);
    clip-path: polygon(2% 0, 98% 5%, 100% 50%, 98% 100%, 1% 95%, 0 50%);
    font-variant-numeric: tabular-nums;
  }
  :global(.l1) .counter { display: block; }

  .next { padding-block: clamp(80px, 14vw, 180px) 64px; }
  .next__link {
    display: grid;
    grid-template-columns: minmax(0, 400px) 1fr;
    grid-template-areas: 'label label' 'img title';
    gap: 12px 28px;
    align-items: end;
    text-decoration: none;
  }
  .next__label { grid-area: label; font-size: var(--t-14); text-transform: uppercase; color: var(--muted); }
  .next__img { grid-area: img; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .next__title {
    grid-area: title;
    font-family: var(--f-marker);
    font-size: var(--t-39);
    line-height: 1;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .next__link:hover .next__title { color: var(--luz-trabajo); }

  /* Móvil: tira horizontal con scroll-snap, región accesible con teclado */
  @media (max-width: 1023px) {
    .stub { grid-column: 1 / -1; }
    .ev__summary, .ev__provisional { grid-column: 1 / -1; }
    .film {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scroll-padding-inline: var(--margin);
    }
    .film__list {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding-bottom: 16px;
      width: max-content;
    }
    .shot { flex: 0 0 calc(100vw - 2 * var(--margin)); scroll-snap-align: start; }
    .shot figure { display: block; }
    .shot__window :global(img) { width: min(100%, calc(48vh * var(--ar))); }
    .shot--portrait .shot__window :global(img) { margin-inline: 0; }
    .shot__side { margin-top: 12px; }
    .counter { bottom: 12px; }
    .next { padding-block: 48px; }
    .next__link { grid-template-columns: 1fr; grid-template-areas: 'label' 'img' 'title'; }
    .next__title { font-size: var(--t-31); }
  }
</style>
