---
// Página "Para editores": sin efectos, sin router, sin fuentes extra en la carga crítica.
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { PERSON, ROUTES, T, wireCaption, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = T[lang];
const es = lang === 'es';

const series = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order);
const picks = series.flatMap((s) =>
  s.data.photos
    .filter((p) => p.featured)
    .map((p) => ({ ...p, slug: s.id, seriesTitle: es ? s.data.title : s.data.title_en })),
);
const anyProvisional = series.some((s) => s.data.provisional);

const site = Astro.site!;
const jsonld = await Promise.all(
  picks.map(async (p) => {
    const img = await getImage({ src: p.file, width: 1600, format: 'jpg' });
    return {
      '@context': 'https://schema.org',
      '@type': 'ImageObject',
      contentUrl: new URL(img.src, site).href,
      caption: es ? p.caption : p.caption_en,
      description: es ? p.alt : p.alt_en,
      dateCreated: p.date.toISOString().slice(0, 10),
      contentLocation: { '@type': 'Place', name: p.place },
      creator: { '@type': 'Person', name: PERSON.name },
      creditText: PERSON.credit,
      copyrightNotice: `© ${p.date.getUTCFullYear()} ${PERSON.name}`,
    };
  }),
);

// Rejilla: 1 col < 640px, 2 col hasta 1100px, 3 col después; contenedor máx. 1400px.
const sizes =
  '(min-width: 1100px) min(30vw, 440px), (min-width: 640px) calc(50vw - 48px), calc(100vw - 32px)';
---

<Base
  title={t.nav.editors}
  description={es
    ? 'Selección de fotoperiodismo de Álvaro Rodríguez Valverde para editores gráficos: fotos con pie completo, disponibilidad y contacto.'
    : 'Photojournalism selects by Álvaro Rodríguez Valverde for picture editors: full captions, availability and contact.'}
  lang={lang}
  altHref={es ? ROUTES.editors.en : ROUTES.editors.es}
  theme="claro"
  page="editors"
  enhanced={false}
  ogImage={picks[0]?.file}
  ogAlt={picks[0] ? (es ? picks[0].alt : picks[0].alt_en) : undefined}
  jsonld={jsonld}
>
  <div class="ed wrap">
    <section class="ed-head" aria-labelledby="ed-name">
      <h1 id="ed-name">{PERSON.name}</h1>
      <p class="ed-what">
        {es
          ? 'Fotoperiodismo, calle, reportaje y actualidad. Madrid. Estudiante de 2.º del Grado Superior de Iluminación, Captación y Tratamiento de Imagen (Campus FP Atocha). Busco mis primeras prácticas en una agencia.'
          : 'Photojournalism, street, reportage and news. Madrid. Second-year student, Higher Vocational Diploma in Lighting, Image Capture and Processing (Campus FP Atocha). Looking for my first internship at an agency.'}
      </p>
      <dl class="ed-facts">
        <div>
          <dt>{es ? 'Disponibilidad' : 'Availability'}</dt>
          <dd>
            {es
              ? 'Prácticas (FCT) desde el 16 de febrero de 2027 hasta completar 440 horas. Horario de mañana o tarde, el que asigne la agencia.'
              : 'Internship (FCT) from 16 February 2027 until 440 hours are completed. Morning or afternoon shifts, whatever the agency assigns.'}
          </dd>
        </div>
        <div>
          <dt>{es ? 'Sobre mí' : 'About'}</dt>
          <dd>
            {/* TODO(bio): bio de 3 líneas en primera persona */}
            <span class="todo">TODO: {es ? 'bio de 3 líneas' : '3-line bio'}</span>
          </dd>
        </div>
        <div>
          <dt>{es ? 'Convenio' : 'Agreement'}</dt>
          <dd>{es ? 'Sin convenio previo: el centro lo tramita.' : 'No prior agreement needed: the school arranges it.'}</dd>
        </div>
        <div>
          <dt>{es ? 'Ficha' : 'Details'}</dt>
          <dd>
            {es
              ? 'Lightroom Classic y Photoshop. Inglés B1. Me muevo en transporte público por toda la Comunidad de Madrid.'
              : 'Lightroom Classic and Photoshop. English B1. I get around the whole Madrid region by public transport.'}
          </dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${PERSON.email}`}>{PERSON.email}</a></dd>
        </div>
        <div>
          <dt>{es ? 'Teléfono' : 'Phone'}</dt>
          <dd><a href={`tel:${PERSON.phoneIntl}`}>{PERSON.phone}</a></dd>
        </div>
      </dl>
      <div class="ed-actions">
        {PERSON.portfolioPdf && <a class="btn btn-primary" href={PERSON.portfolioPdf} download>{t.downloadPdf}</a>}
        {
          PERSON.email && (
            <button class="btn" type="button" data-copy={PERSON.email} data-copied={t.copied}>
              {t.copyEmail}
            </button>
          )
        }
        <span id="copy-status" class="copy-status" role="status" aria-live="polite"></span>
      </div>
      {anyProvisional && <p class="ed-provisional">{t.provisional}</p>}
    </section>

    <section aria-labelledby="ed-picks">
      <h2 id="ed-picks" class="ed-h2">
        {es ? `${picks.length} fotos seleccionadas` : `${picks.length} selected photos`}
      </h2>
      <ol class="ed-grid" role="list">
        {
          picks.map((p, i) => (
            <li>
              <figure>
                <Picture
                  src={p.file}
                  alt={es ? p.alt : p.alt_en}
                  formats={['avif', 'webp']}
                  widths={[320, 480, 640, 720, 880, 1100]}
                  sizes={sizes}
                  quality={72}
                  loading={i < 3 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
                <figcaption>
                  {wireCaption(p.place, p.date, es ? p.caption : p.caption_en, lang)}
                  <span class="ed-tools">
                    <a class="ed-series" href={ROUTES.series[lang](p.slug)}>
                      {p.seriesTitle}
                    </a>
                    <button
                      class="ed-copy"
                      type="button"
                      data-copy={wireCaption(p.place, p.date, es ? p.caption : p.caption_en, lang)}
                      data-copied={es ? 'Pie copiado' : 'Caption copied'}
                    >
                      {es ? 'Copiar pie' : 'Copy caption'}
                    </button>
                  </span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <script is:inline>
    (function () {
      var s = document.getElementById('copy-status');
      document.addEventListener('click', function (ev) {
        var b = ev.target.closest && ev.target.closest('[data-copy]');
        if (!b) return;
        var v = b.getAttribute('data-copy');
        var ok = function () {
          var t = b.textContent;
          s.textContent = b.getAttribute('data-copied');
          b.textContent = b.getAttribute('data-copied');
          setTimeout(function () { b.textContent = t; }, 1600);
        };
        if (navigator.clipboard) navigator.clipboard.writeText(v).then(ok, function () {});
      });
    })();
  </script>
</Base>

<style>
  .ed {
    padding-bottom: 96px;
  }
  .ed-head {
    padding-block: 24px 40px;
    max-width: 72ch;
  }
  /* Escritorio: dos columnas para que la primera fila de fotos se vea sin hacer scroll */
  @media (min-width: 1024px) {
    .ed-head {
      max-width: none;
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-areas:
        'name facts'
        'what facts'
        'what actions'
        'prov actions';
      column-gap: clamp(32px, 5vw, 80px);
      align-items: start;
      padding-block: 16px 28px;
    }
    .ed-head h1 { grid-area: name; }
    .ed-what { grid-area: what; max-width: 60ch; }
    .ed-facts { grid-area: facts; margin-top: 6px; }
    .ed-actions { grid-area: actions; margin-top: 20px; }
    .ed-provisional { grid-area: prov; margin-top: 12px; }
    .ed-head h1 {
      font-size: clamp(2.5rem, 4.6vw, 4.25rem);
    }
  }
  h1 {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .ed-what {
    margin-top: 16px;
    font-size: var(--t-16);
  }
  .ed-facts {
    margin-top: 24px;
    display: grid;
    gap: 10px;
    font-size: var(--t-14);
  }
  .ed-facts div {
    display: grid;
    grid-template-columns: minmax(0, 9.5rem) minmax(0, 1fr);
    gap: 12px;
  }
  @media (max-width: 399px) {
    .ed-facts div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
  .ed-facts dt {
    color: var(--meta);
  }
  .ed-actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .btn {
    display: inline-block;
    padding: 12px 18px;
    border: 1.5px solid var(--grafito);
    background: transparent;
    font-size: var(--t-14);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    min-height: 44px;
  }
  .btn-primary {
    background: var(--grafito);
    color: var(--papel-claro);
  }
  .btn-primary:hover {
    background: var(--lapiz-texto);
    border-color: var(--lapiz-texto);
    color: var(--papel-claro);
  }
  .btn:not(.btn-primary):hover:not(:disabled) {
    border-color: var(--lapiz-texto);
    color: var(--lapiz-texto);
  }
  .btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .copy-status {
    font-size: var(--t-14);
    color: var(--meta);
  }
  .ed-provisional {
    margin-top: 20px;
    font-size: var(--t-12);
    color: var(--meta);
  }
  .ed-h2 {
    font-size: var(--t-14);
    font-weight: 500;
    padding-block: 12px;
    border-top: 1.5px solid var(--grafito);
    margin-bottom: 24px;
  }
  .ed-grid {
    display: grid;
    gap: 48px 24px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .ed-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .ed-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  figure img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: contain;
    background: var(--cuarto-oscuro);
  }
  figcaption {
    margin-top: 10px;
    font-size: var(--t-12);
    line-height: 1.6;
    max-width: 60ch;
  }
  .ed-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
    margin-top: 6px;
  }
  .ed-series {
    color: var(--meta);
    padding-block: 10px;
  }
  .ed-copy {
    border: 0;
    background: none;
    padding: 10px 0;
    font-size: var(--t-12);
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .ed-copy:hover {
    color: var(--lapiz-texto);
  }
</style>
