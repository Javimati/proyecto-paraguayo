---
import Base from '../layouts/Base.astro';
import { T } from '../i18n/strings';
---
<Base title={`${T.es.notFoundTitle}`} description={T.es.notFoundText} lang="es" altHref="/en/" page="notfound" footer={false} noindex>
  <div class="nf wrap">
    <div class="nf__slide" aria-hidden="true">
      <span class="nf__window"></span>
      <span class="nf__label"><span>—</span><span>000</span></span>
    </div>
    <div class="nf__text">
      <h1>{T.es.notFoundTitle}</h1>
      <p>{T.es.notFoundText} <a href="/">Volver a la mesa de luz</a>.</p>
      <div lang="en">
        <p class="nf__en">{T.en.notFoundTitle}</p>
        <p>{T.en.notFoundText} <a href="/en/">Back to the light table</a>.</p>
      </div>
    </div>
  </div>
</Base>
<style>
  .nf {
    min-height: 70svh;
    display: grid;
    grid-template-columns: minmax(180px, 320px) 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding-block: 32px;
  }
  .nf__slide {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: var(--montura);
    border-radius: 9px;
    rotate: -3deg;
    box-shadow: 0 0 0 1px rgba(22, 24, 27, 0.06), 0 12px 30px -14px rgba(22, 24, 27, 0.4);
  }
  /* ventana vacía: pasa la luz de la mesa */
  .nf__window {
    width: 76%;
    aspect-ratio: 3 / 2;
    background: radial-gradient(circle at 50% 50%, #ffffff 0%, #f6f8f5 60%, #e8ebe6 100%);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18), 0 0 40px 10px rgba(255, 255, 255, 0.9);
  }
  .nf__label {
    position: absolute;
    left: 9%;
    right: 9%;
    bottom: 3%;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--tinta-2);
  }
  .nf__text {
    display: grid;
    gap: 14px;
    max-width: 52ch;
  }
  h1 {
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .nf__en {
    margin-top: 18px;
    font-family: var(--f-serif);
    font-size: var(--t-25);
  }
  @media (max-width: 700px) {
    .nf {
      grid-template-columns: 1fr;
    }
    .nf__slide {
      width: 60%;
    }
  }
</style>
